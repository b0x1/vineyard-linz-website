  <Section>
    <h3>Vineyard Linz Kalender</h3>
    <ChurchSuite id="calendar" />
  </Section>

  <GoogleForm id="1GDMtljhVKK3Zo40DBCWfdIthqtjuqIW5qxs3n6XOICw" />
</Base>
