import Section from '../components/sections/Section.astro';
import ChurchSuite from '../components/sections/ChurchSuite.astro';
import GoogleForm from '../components/sections/GoogleForm.astro';
---

<Base title="Kalender" description="Vineyard Linz Kalender - Unsere Events">
