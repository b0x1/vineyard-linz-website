---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = await getEntry('pages', 'startseite');
if (!page) {
  throw new Error('Missing content/pages/startseite.mdx');
}
const { Content } = await render(page);
---

<Base title="Vineyard Linz" description={page.data.description}>
  <Content />
</Base>
