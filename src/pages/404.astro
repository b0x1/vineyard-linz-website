---
import Base from '../layouts/Base.astro';
---

<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht.">
  <div class="px-4 py-20 text-center">
    <h1 class="text-3xl font-bold uppercase tracking-tight text-ink md:text-5xl">Seite nicht gefunden</h1>
    <p class="mt-8">
      <a class="font-bold text-brand-blue" href={import.meta.env.BASE_URL}>Zur Startseite</a>
    </p>
  </div>
</Base>
