---
import Base from '../layouts/Base.astro';
---

<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht.">
  <div class="bg-brand py-8 text-center text-white">
    <h1 class="text-3xl md:text-4xl font-bold uppercase tracking-widest">Seite nicht gefunden</h1>
  </div>
  <p class="text-center py-16">
    <a class="text-brand font-bold" href={import.meta.env.BASE_URL}>Zur Startseite</a>
  </p>
</Base>
