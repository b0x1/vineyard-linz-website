---
import { footerLinks, socialLinks } from '../data/nav';
import { withBase } from '../lib/withBase';
import OptimizedImage from './OptimizedImage.astro';
---

<footer class="bg-[#181516] py-16 text-white">
  <div class="mx-auto grid max-w-6xl items-end gap-12 px-4 md:grid-cols-2">
    <div>
      <nav class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
        {
          footerLinks.map((link) => (
            <a href={withBase(link.href)} class="text-sm text-white/80 hover:text-brand-gold">
              {link.name}
            </a>
          ))
        }
      </nav>
      <div class="mt-8 flex gap-4">
        {
          socialLinks.map((social) => (
            <a
              href={withBase(social.href)}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <OptimizedImage src={social.icon} alt={social.name} width={32} height={32} class="h-8 w-8 object-contain" />
            </a>
          ))
        }
      </div>
    </div>
    <a href={import.meta.env.BASE_URL} class="justify-self-center md:justify-self-end">
      <OptimizedImage
        src="/images/vlinz-logo-mono-red.png"
        alt="Vineyard Linz"
        width={458}
        class="h-auto w-full max-w-md"
      />
    </a>
  </div>
</footer>
