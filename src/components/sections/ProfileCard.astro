---
import { withBase } from '../../lib/withBase';

interface Props {
  name: string;
  image: string;
}

const { name, image } = Astro.props;
---

<div class="flex flex-col items-center">
  <div class="relative w-full aspect-[4/3] max-w-2xl overflow-hidden rounded-lg shadow-lg mb-4 pointer-events-none">
    <img src={withBase(image)} alt={name} class="absolute inset-0 h-full w-full object-cover" />
  </div>
  <p class="text-xl font-bold text-gray-900">{name}</p>
</div>
