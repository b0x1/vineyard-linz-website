---
import { withBase } from '../../lib/withBase';

interface Props {
  title: string;
  subtitle: string;
  link: string;
  linkText: string;
}

const { title, subtitle, link, linkText } = Astro.props;
---

<div class="flex flex-col h-full bg-white border border-gray-100 p-8 shadow-sm hover:shadow-md transition-shadow">
      <h3 class="mb-1 text-xl font-bold text-ink">{title}</h3>
      <p class="mb-6 text-sm font-bold uppercase tracking-wider text-brand-red">{subtitle}</p>
      <div class="mb-8 flex-grow leading-relaxed text-ink">
    <slot />
  </div>
  <a
    href={withBase(link)}
    class="text-brand font-bold uppercase text-sm border-b-2 border-brand pb-1 self-start hover:text-brand-dark hover:border-brand-dark transition-colors"
  >
    {linkText}
  </a>
</div>
