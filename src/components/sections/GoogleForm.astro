---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="w-full my-12 border border-gray-100 rounded-lg overflow-hidden shadow-sm">
  <iframe
    src={`https://docs.google.com/forms/d/${id}/viewform?embedded=true`}
    width="100%"
    height="800"
    class="border-0"
  >
    Wird geladen…
  </iframe>
</div>
