---
interface Props {
  color: 'red' | 'blue' | 'yellow' | 'magenta' | 'orange';
}

const { color } = Astro.props;
const bands = {
  red: 'bg-[rgb(192,22,39)] text-ink',
  blue: 'bg-[rgb(13,116,176)] text-ink',
  yellow: 'bg-[rgb(248,210,31)] text-ink',
  magenta: 'bg-brand-magenta text-ink',
  orange: 'bg-brand-orange text-ink',
};
---

<section class:list={['px-4 py-12 text-center', bands[color]]}>
  <p class="text-3xl font-normal md:text-5xl"><slot /></p>
</section>
