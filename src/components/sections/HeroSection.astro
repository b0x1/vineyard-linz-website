---
import { withBase } from '../../lib/withBase';

interface Props {
  title: string;
  image?: string;
}

const { title, image } = Astro.props;
---

<section class="py-12 md:py-20 bg-white">
  <div class="flex flex-col items-center text-center">
    {image && (
      <div class="mb-8">
        <img src={withBase(image)} alt={title} width="400" height="200" class="h-auto w-auto max-w-[300px] md:max-w-[400px]" />
      </div>
    )}
    <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6 uppercase tracking-tight">{title}</h1>
    <div class="max-w-2xl text-lg text-gray-600 leading-relaxed">
      <slot />
    </div>
  </div>
</section>
