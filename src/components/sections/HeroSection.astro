---
import OptimizedImage from '../OptimizedImage.astro';

interface Props {
  title: string;
  image?: string;
}

const { title, image } = Astro.props;
---

<section class="bg-white py-12 text-center md:py-20">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4">
    {
      image && (
        <OptimizedImage src={image} alt="" width={160} height={160} class="mb-8 h-auto w-28 md:w-36" />
      )
    }
    <h1 class="mb-6 text-3xl font-bold uppercase tracking-tight text-ink md:text-5xl">{title}</h1>
    <div class="prose prose-lg text-ink prose-p:text-ink prose-a:text-brand-blue">
      <slot />
    </div>
  </div>
</section>
