---
import OptimizedImage from '../OptimizedImage.astro';

interface Props {
  author: string;
  image?: string;
}

const { author, image } = Astro.props;
---

<section class="bg-white px-4 py-16">
  <div class="mx-auto max-w-3xl text-center text-ink">
    {
      image && (
        <OptimizedImage src={image} alt="" width={64} height={64} class="mx-auto mb-6 h-12 w-12" />
      )
    }
    <p class="text-7xl font-bold leading-none" aria-hidden="true">„</p>
    <blockquote class="text-xl italic leading-relaxed md:text-2xl">
      <slot />
    </blockquote>
    <p class="text-7xl font-bold leading-none" aria-hidden="true">“</p>
    <cite class="mt-4 block font-bold uppercase not-italic tracking-wider text-brand-red">{author}</cite>
  </div>
</section>
