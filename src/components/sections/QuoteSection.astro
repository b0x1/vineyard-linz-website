---
import { withBase } from '../../lib/withBase';

interface Props {
  author: string;
  image?: string;
}

const { author, image } = Astro.props;
---

<section class="py-16 bg-gray-50 border-y border-gray-100">
  <div class="max-w-4xl mx-auto px-4 text-center">
    {image && (
      <div class="flex justify-center mb-6">
        <img src={withBase(image)} alt="" width="60" height="60" class="w-12 h-12" />
      </div>
    )}
    <blockquote class="text-2xl md:text-3xl italic text-gray-800 mb-6 leading-snug">
      &bdquo;<slot />&ldquo;
    </blockquote>
    <cite class="text-brand font-bold not-italic uppercase tracking-wider">{author}</cite>
  </div>
</section>
