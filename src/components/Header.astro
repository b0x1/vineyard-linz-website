---
import { headerLinks } from '../data/nav';
import { withBase } from '../lib/withBase';
import OptimizedImage from './OptimizedImage.astro';
---

<header class="sticky top-0 z-50 bg-black/[0.07] backdrop-blur-sm">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-1 px-4 py-3" aria-label="Global">
    <a href={import.meta.env.BASE_URL} class="mr-2 shrink-0">
      <span class="sr-only">Vineyard Linz</span>
      <OptimizedImage src="/images/vlinz-sq-icon-cmyk.png" alt="" width={56} height={56} class="h-12 w-12" />
    </a>
    {
      headerLinks.map((item) => (
        <a href={withBase(item.href)} class:list={['text-xl font-bold tracking-tight md:text-2xl', item.color]}>
          {item.name}
        </a>
      ))
    }
  </nav>
</header>
